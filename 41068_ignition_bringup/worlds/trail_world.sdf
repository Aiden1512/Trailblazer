<?xml version="1.0"?>
<sdf version='1.8'>

  <world name="trail_world">
    <!-- Basic world setup  -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <shadows>1</shadows>
    </scene>

    <!-- Initialise spherical coordinates somewhere -->
    <spherical_coordinates>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <gravity>0 0 -9.81</gravity>

    <include>
      <uri>model://Trail_Ground</uri>
      <name>trail_ground</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    
    <!-- Junction 1 -->
    <include>
      <uri>model://Birch</uri>
      <name>Junction1.1</name>
      <pose>5 3.1 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://Birch</uri>
      <name>Junction1.2</name>
      <pose>7 2 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://Birch</uri>
      <name>Junction1.3</name>
      <pose>6.8 4.2 0 0 0 0</pose>
    </include>

    <!-- Junction 2 -->
    <include>
      <uri>model://Birch</uri>
      <name>Junction2.1</name>
      <pose>0.5 3.5 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://Birch</uri>
      <name>Junction2.2</name>
      <pose>-1.4 4.5 0 0 0 0</pose>
    </include>

        <include>
      <uri>model://Birch</uri>
      <name>Junction2.3</name>
      <pose>-1.7 2.7 0 0 0 0</pose>
    </include>

        <!-- Junction 3 -->
    <include>
      <uri>model://Birch</uri>
      <name>Junction3.1</name>
      <pose>-3.6 -1 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://Birch</uri>
      <name>Junction3.2</name>
      <pose>-5.2 -0.2 0 0 0 0</pose>
    </include>

        <include>
      <uri>model://Birch</uri>
      <name>Junction3.3</name>
      <pose>-3.4 0.6 0 0 0 0</pose>
    </include>

        <!-- Junction 4 -->
    <include>
      <uri>model://Birch</uri>
      <name>Junction4.1</name>
      <pose>0.6 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://Birch</uri>
      <name>Junction4.2</name>
      <pose>-0.8 -1.2 0 0 0 0</pose>
    </include>

        <include>
      <uri>model://Birch</uri>
      <name>Junction4.3</name>
      <pose>1 -1.7 0 0 0 0</pose>
    </include>

  </world>

</sdf>
