<?xml version="1.0"?>

<sdf version="1.7">

  <model name="Trail_Ground">

    <static>true</static>

    <link name="ground_link">

      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>15 15</size>
          </plane>
        </geometry>
      </collision>

      <visual name="visual">

        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>15 15</size>
          </plane>
        </geometry>

       
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://Trail_Ground/Materials/Textures/Floor_Texture.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>

      </visual>

    </link>

  </model>

</sdf>