<?xml version="1.0"?>
<sdf version="1.8">

  <model name="Trail_Ground">
    <static>true</static>

    <link name="ground_link">

      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>15 15</size>
          </plane>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>15 15</size>
          </plane>
        </geometry>

      <material>
        <ambient>1 1 1 1</ambient>
        <diffuse>1 1 1 1</diffuse>
        <pbr>
          <metal>
            <albedo_map>model://Trail_Ground/Materials/Textures/Floor_Texture.png</albedo_map>
            <metalness>0.0</metalness>
            <roughness>1.0</roughness>
          </metal>
        </pbr>
      </material>

      </visual>
    </link>
  </model>

</sdf>